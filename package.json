{
  "name": "xenolith-bridge",
  "version": "0.3.0",
  "license": "MIT",
  "description": "Local Responses and Chat Completions HTTP/SSE bridge for the Xenolith wire protocol",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "xenolith-bridge": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test test/*.test.js",
    "test:codex": "node --test test/integration/*.test.js",
    "test:chat": "node --test test/client/*.test.js",
    "test:aider": "node --test test/harness/*.test.js",
    "test:model": "node test/model/smoke.js",
    "test:persistence": "node test/model/persistence.js",
    "test:aider:real": "node test/model/aider.js",
    "test:aider:feedback:real": "node test/model/aider.js --feedback",
    "test:kv": "node test/model/kv.js",
    "test:sdk": "node --test test/client/*.test.js",
    "test:package": "node --test test/package/*.test.js",
    "test:release:real": "node test/model/release.js"
  },
  "files": [
    "src/",
    "test/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "ACCEPTANCE.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crrisci/xenolith-bridge.git"
  },
  "homepage": "https://github.com/crrisci/xenolith-bridge#readme",
  "bugs": {
    "url": "https://github.com/crrisci/xenolith-bridge/issues"
  }
}
